{
  "manifest_version": 3,
  "name": "YaadKar",
  "version": "1.0.0",
  "description": "Summarize the current YouTube video with a FastAPI backend.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "YaadKar",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
